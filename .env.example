# JARVIS environment example.
#
# Copy this file to ".env" and fill in your values. The ".env" file is ignored
# by Git and must never be committed. Real environment variables always take
# precedence over the values here.
#
# Everything below is OPTIONAL. With no API key JARVIS runs fully offline and
# behaves exactly as it did before AI features existed.

# --- Optional AI provider (OpenAI-compatible) -----------------------------
# Your API key. Leave blank to disable AI completely.
JARVIS_LLM_API_KEY=

# Base URL of an OpenAI-compatible /chat/completions endpoint.
# OpenAI:            https://api.openai.com/v1
# Local (Ollama):    http://localhost:11434/v1
# Local (LM Studio): http://localhost:1234/v1
JARVIS_LLM_BASE_URL=https://api.openai.com/v1

# Model name understood by the endpoint above.
JARVIS_LLM_MODEL=gpt-4o-mini

# Provider implementation. Only "openai_compatible" ships today.
JARVIS_LLM_PROVIDER=openai_compatible

# Per-call timeout, in seconds.
JARVIS_LLM_TIMEOUT=15

# Master switch for AI features (still requires a key to do anything).
JARVIS_AI_ENABLED=true

# --- Local storage --------------------------------------------------------
# Command history is OFF by default for privacy and is toggled inside the app
# (it stores only the text of commands — never audio, never file contents). You
# can clear all stored data at any time from the Privacy / AI panel.
